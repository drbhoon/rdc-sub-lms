DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rdc_lms"
APP_URL="http://localhost:3000"
SESSION_COOKIE_NAME="rdc_lms_session"
SESSION_DAYS="30"
STORAGE_PROVIDER="local"
STORAGE_ROOT="./storage"
MAX_UPLOAD_MB="100"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="RDC Learning <noreply@rdc.in>"
OTP_TTL_MINUTES="10"
OTP_RESEND_SECONDS="60"
OTP_MAX_ATTEMPTS="5"
SUPER_ADMIN_EMAILS=""
# Leave OPENAI_API_KEY blank to disable AI entirely. Note what that means: the
# learner assistant degrades politely, but the worker marks every uploaded
# document FAILED with "OpenAI API key is not configured", so teachers cannot
# publish content at all.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4-mini"
# Spend cap for the learner AI assistant, in rupees per learner per course.
# Charged on the tokens OpenAI reports; once reached the learner is told they
# have exceeded their allowance. At the gpt-5.4-mini rates this is roughly
# 65-190 questions depending on how much course material there is to send.
# Study-pack generation is separate and NOT capped by this.
LMS_AI_BUDGET_INR="100"
# Used to convert the USD prices in src/lib/ai-budget.ts into rupees. Update
# occasionally; the cap only needs to be roughly right.
LMS_AI_USD_TO_INR="95.2"
# Continuous voice uses the OpenAI Realtime API over WebRTC. The model and
# transcription model are configurable so they can be changed without code.
OPENAI_REALTIME_MODEL="gpt-realtime-2.1-mini"
OPENAI_REALTIME_TRANSCRIPTION_MODEL="gpt-realtime-whisper"
# Audio token prices used only for the LMS per-learner spend cap calculation.
LMS_AI_REALTIME_AUDIO_INPUT_USD_PER_MTOK="10"
LMS_AI_REALTIME_AUDIO_OUTPUT_USD_PER_MTOK="20"
